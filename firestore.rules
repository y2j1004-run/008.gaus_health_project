rules_version = '2';

// 크롱과 함께하는 가우스 근력챌린지 - Firestore 보안 규칙
// - 누구나 현황/피드를 볼 수 있어요 (읽기 공개).
// - 참가자 = Firebase 로그인 계정 1개 (이름 + 4자리 PIN으로 로그인).
// - 내 목표 수정, 내 기록 추가/삭제는 본인만 가능해요.
// - 응원(👏)과 한줄 코멘트는 로그인한 참가자가 '내 이름'으로만 남기고 지울 수 있어요.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function participantPath(id) {
      return /databases/$(database)/documents/participants/$(id);
    }
    function isStr(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function validGoals(g) {
      return g is list && g.size() <= 12;
    }
    function validDays(d) {
      return d is list && d.size() <= 7;
    }

    // 참가자: 문서 ID = 로그인 계정 uid
    match /participants/{uid} {
      allow read: if true;

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'loginKey', 'goals', 'days', 'createdAt'])
        && isStr(request.resource.data.name, 1, 20)
        && isStr(request.resource.data.loginKey, 8, 40)
        && validGoals(request.resource.data.goals)
        && validDays(request.resource.data.days)
        && request.resource.data.createdAt is string
        // 이름 중복 방지: 같은 배치에서 names/{이름} 문서를 내 uid로 만들어야 함
        && getAfter(/databases/$(database)/documents/names/$(request.resource.data.name)).data.uid == uid;

      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['goals', 'days'])
        && validGoals(request.resource.data.goals)
        && validDays(request.resource.data.days);

      allow delete: if false;
    }

    // 이름 예약 (중복 이름 방지용). 문서 ID = 이름
    match /names/{name} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(participantPath(request.auth.uid)).data.name == name;
      allow update, delete: if false;
    }

    // 운동 기록
    match /logs/{logId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['participantId', 'date', 'results', 'note', 'createdAt', 'cheers', 'comments'])
        && request.resource.data.participantId == request.auth.uid
        && exists(participantPath(request.auth.uid))
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.results is list
        && request.resource.data.results.size() <= 20
        && isStr(request.resource.data.note, 0, 500)
        && request.resource.data.createdAt is string
        && request.resource.data.cheers == []
        && request.resource.data.get('comments', []) == [];

      allow delete: if signedIn() && resource.data.participantId == request.auth.uid;

      // 응원 토글: cheers 칸만, 그것도 '내 이름'만 넣고 뺄 수 있음
      allow update: if signedIn() && exists(participantPath(request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cheers'])
        && request.resource.data.cheers is list
        && request.resource.data.cheers.size() <= 300
        && onlyMyCheerChanged();

      // 한줄 응원 코멘트: comments 칸만, '내 이름'으로 1개 추가하거나 내 코멘트 1개 삭제
      allow update: if signedIn() && exists(participantPath(request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
        && request.resource.data.comments is list
        && commentChangeOk(get(participantPath(request.auth.uid)).data.name,
                           resource.data.get('comments', []), request.resource.data.comments);
    }

    function validComment(c, myName) {
      return c is map && c.keys().hasOnly(['name', 'text', 'at'])
        && c.name == myName
        && isStr(c.text, 1, 100)
        && c.at is string;
    }
    function commentChangeOk(myName, before, after) {
      return (after.size() == before.size() + 1 && after.size() <= 200
                && after.hasAll(before) && validComment(after.removeAll(before)[0], myName))
        || (after.size() == before.size() - 1
                && before.hasAll(after) && before.removeAll(after)[0].name == myName);
    }

    function onlyMyCheerChanged() {
      let myName = get(participantPath(request.auth.uid)).data.name;
      let after = request.resource.data.cheers.toSet();
      let before = resource.data.cheers.toSet();
      return after.difference(before).union(before.difference(after)).hasOnly([myName]);
    }
  }
}
